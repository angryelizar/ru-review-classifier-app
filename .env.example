# Hugging Face token (needed if model/dataset are private)
HF_TOKEN=hf_...

# Model
MODEL_REPO_ID=angryelizar/ruBert-base-sentiment-classifier
MODEL_MAX_LENGTH=267

# Dataset
DATASET_REPO_ID=angryelizar/sentiment_dataset_splitted
DATASET_CONFIG=
DATASET_SPLIT=test
DATASET_TEXT_COLUMN=text
DATASET_LABEL_COLUMN=label
DATASET_SRC_COLUMN=src
# Rows kept in memory after shuffling at startup. 0 = whole split.
DATASET_SAMPLE_SIZE=5000

# Raw model label -> human-readable name (JSON)
LABEL_MAPPING={"LABEL_0":"neutral","LABEL_1":"positive","LABEL_2":"negative"}

# App
APP_TITLE=fsociety // sentiment
HOST=127.0.0.1
PORT=8000
